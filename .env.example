# Configuração padrão do curso: API da Mistral.
#
#   cp .env.example .env
#
# Depois preencha a chave abaixo. Para rodar local com o Ollama em vez da API,
# use o outro modelo de arquivo:  cp .env.ollama .env

# Sua chave da Mistral. Crie em https://admin.mistral.ai/ (menu API Keys).
# O nome é OPENAI_API_KEY porque usamos o SDK da OpenAI apontado para a
# Mistral — é a variável que o SDK procura. O valor é a chave da Mistral.
OPENAI_API_KEY=

# Endpoint compatível com a API da OpenAI.
LLM_BASE_URL=https://api.mistral.ai/v1

# Modelo padrão dos exemplos.
LLM_MODELO=mistral-small-latest

# Os scripts 06 e 07 da aula 02 comparam modelos entre si, então os nomes deles
# ficam fixos no próprio script — não são configuração, são o experimento.
# Se precisar trocar, edite o topo daqueles dois arquivos.
